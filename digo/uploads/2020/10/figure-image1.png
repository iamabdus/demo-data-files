}

.clip_2{
	clip-path: polygon(0% 0%, 0% 0%, 100% 0, 100% 100%, 0% 85%);
}

.clip_3{
	clip-path: polygon(0% 0%, 0% 16%, 100% 0, 100% 100%, 0% 100%);
}

.clip_4{
	clip-path: polygon(0% 0%, 0% 0%, 100% 16%, 100% 100%, 0% 100%);
}
}



