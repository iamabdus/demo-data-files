out\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"theme-palette2\",\"textColor\":\"theme-palette9\"} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-theme-palette-9-color has-theme-palette-2-background-color has-text-color has-background wp-element-button\">Order Now!<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns -->"}}}